#!/bin/bash
# Runs once, at the end of installing beethoven-bridge-mac.pkg, as the account the Installer runs
# for: tells Chrome (and Edge and Chromium, when they are installed) where the Beethoven bridge now
# is. The Installer passes the package's path as $1 and the install destination as $2; for a package
# that installs into the current user's home (distribution.xml) that destination is the home, so
# $2 is used when it is a folder and $HOME otherwise. That the Installer passes the home as $2 for
# such a package is not yet measured on a real Mac, which is why both are read.
#
# It writes one small JSON file per browser folder and deletes nothing. It refuses, exit 1 with one
# sentence, unless the package's own allowed_origins.json is a list of Beethoven's extension
# origins, because a manifest with anything else in it would let some other extension start the
# bridge. Bash 3.2 (what macOS ships).

set -u
NAME=com.openspineconsortium.beethoven.bridge
if [ -n "${2:-}" ] && [ -d "$2" ]; then
  HOME_DIR=$2
else
  HOME_DIR=${HOME:-}
fi
AS="$HOME_DIR/Library/Application Support"
ROOT="$AS/Beethoven/bridge"

say() { printf '%s\n' "$*"; }
json_escape() { printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'; }

if [ -z "$HOME_DIR" ] || [ ! -d "$HOME_DIR" ]; then
  say "The home folder to install into could not be found, so Chrome was not told about the bridge."
  exit 1
fi
if [ ! -f "$ROOT/beethoven-bridge" ] || [ ! -f "$ROOT/allowed_origins.json" ]; then
  say "The Beethoven bridge's files were not found in $ROOT, so Chrome was not told about it."
  exit 1
fi

ORIGINS=$(tr -d '\r\n' < "$ROOT/allowed_origins.json")
if ! printf '%s' "$ORIGINS" | grep -Eq '^\[ *"chrome-extension://[a-p]{32}/"( *, *"chrome-extension://[a-p]{32}/")* *\]$'; then
  say "This package was built without Beethoven's extension identifier, so Chrome was not told about the bridge."
  exit 1
fi

# pkgbuild recorded these modes already; the Installer is expected to keep them, and this costs nothing.
chmod 755 "$ROOT/beethoven-bridge" "$ROOT/uninstall.command" 2>/dev/null

DIRS="$AS/Google/Chrome/NativeMessagingHosts"
[ -d "$AS/Microsoft Edge" ] && DIRS="$DIRS:$AS/Microsoft Edge/NativeMessagingHosts"
[ -d "$AS/Chromium" ] && DIRS="$DIRS:$AS/Chromium/NativeMessagingHosts"

HOSTPATH=$(json_escape "$ROOT/beethoven-bridge")
OLDIFS=$IFS
IFS=:
set -f
for d in $DIRS; do
  [ -n "$d" ] || continue
  if ! mkdir -p "$d"; then
    say "The folder $d could not be made, so that browser was not told about the bridge."
    exit 1
  fi
  if ! printf '{\n  "name": "%s",\n  "description": "%s",\n  "path": "%s",\n  "type": "stdio",\n  "allowed_origins": %s\n}\n' \
      "$NAME" "The Beethoven bridge: carries Beethoven's encrypted connection to the grid." \
      "$HOSTPATH" "$ORIGINS" > "$d/$NAME.json"; then
    say "The file $d/$NAME.json could not be written, so that browser was not told about the bridge."
    exit 1
  fi
  say "Wrote $d/$NAME.json"
done
set +f
IFS=$OLDIFS
exit 0
