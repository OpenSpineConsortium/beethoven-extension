#!/bin/bash
# A stand-in for the framework's `hpcworker` command (framework/bin/hpcworker, version 1), seeded
# into the mock home so the extension's buttons have something to talk to. Same verbs, same
# printed sentences, same files in the same places (contract.ts), with plausible contents; it
# submits nothing and deletes nothing. "Set up the cluster" overwrites this file with the real
# tool when the build carries one, and the real tool's install then keeps the profile this one wrote.
#
# What it mimics from the maintainer's live run of Claude Code 2.1.283 (2026-09-28/29): the
# registration block `claude remote-control` prints after its QR code, with a session name Claude
# Code chose itself (asx10-hazy-meadow) and an environment link that is stable per machine, so a
# second worker on the same login joins the same environment.
#
# Environment knobs (tests and reviewers): MOCK_LOGGED_IN=false, MOCK_CONSENT=false,
# MOCK_EGRESS=none change what the seeded probe reports; MOCK_ENV_ID sets the environment id;
# MOCK_LOGIN_FAIL=1 makes `claude login --plain` end with HPCW-LOGIN-FAILED whatever code is typed;
# MOCK_DISPLAY_HOME is the home this tool shows in place of the real one (below).
#
# The lab's shared copy (framework 5): MOCK_SHARED_INSTALL is its folder as the portal shows it and
# MOCK_SHARED_REAL where it sits on disk (server.mjs --shared-install, which also seeds a copy of
# this file there). `install --shared DIR` then sets the account up the way framework 5 does,
# copying no code: a launcher at ~/.hpcworker/bin/hpcworker (a regular file) that runs
# DIR/bin/hpcworker, the marker ~/.hpcworker/shared naming the folder, the profile, log/. An own
# copy found in ~/.hpcworker is moved aside, never deleted; a plain `install` moves the marker
# aside in turn, so the account runs its own copy again. `version` says which copy runs.
#
# Framework 10 (Beethoven 11.0.0, docs/V11_CONTRACT.md): `connect`, `worker status [--json]`,
# `worker stop`, `worker restrict`, `claude consent --record ID` and `login-setup [--remove]` are
# answered by lib/tool.mjs (Node, which reads the pasted code from standard input with the keepalive
# around it). `worker start` is framework 10's too (the queued status.json, the job in line, the job
# simulator of the mock portal taking it to online) whenever MOCK_SIM=1, MOCK_QUEUE_S or MOCK_START_S
# is set, and always under `connect`; otherwise it keeps the 10.0.0 stand-in's instant start, which
# the 10.0.0 tests and its reviewer recipe rely on (the status is online at once). The state folder
# of a profile under /rs/rs_grp_oschome/$USER (Wayne State's) lives on disk where MOCK_ROOTS_SH says.
set -u
HPCW_HOME="${HPCW_HOME:-$HOME/.hpcworker}"
PROFILE="$HPCW_HOME/profile.json"
# The real tool prints and records cluster paths. Here $HOME is wherever the mock home sits on the
# machine running the mock (a temp folder on a laptop, say), so every path this tool prints or
# writes into its status files is shown with MOCK_DISPLAY_HOME in place of that prefix; server.mjs
# passes the portal's own /home/<user>, the path the Files app shows the extension. The files
# themselves stay where they are. The shared copy's folder on disk is shown as its portal path too.
DISPLAY_HOME="${MOCK_DISPLAY_HOME:-$HOME}"
show() {
  local s="$1" pair v r
  # the extra roots first (they may sit inside the home's folder on disk), then the home, then the shared copy
  if [ -n "${MOCK_ROOTS_SH:-}" ]; then
    while IFS= read -r -d ';' pair; do v="${pair%%=*}"; r="${pair#*=}"; [ -n "$r" ] && s="${s//"$r"/$v}"; done <<< "${MOCK_ROOTS_SH%;};"
  fi
  s="${s//"$HOME"/$DISPLAY_HOME}"
  [ -n "${MOCK_SHARED_REAL:-}" ] && s="${s//"$MOCK_SHARED_REAL"/${MOCK_SHARED_INSTALL:-$MOCK_SHARED_REAL}}"
  printf '%s' "$s"
}
map_root() { # a path as the portal shows it under an extra root (/rs/rs_grp_oschome/<user>) -> where it is on disk
  local p="$1" pair v r
  if [ -n "${MOCK_ROOTS_SH:-}" ]; then
    while IFS= read -r -d ';' pair; do v="${pair%%=*}"; r="${pair#*=}"; case "$p" in "$v"|"$v"/*) p="$r${p#"$v"}";; esac; done <<< "${MOCK_ROOTS_SH%;};"
  fi
  printf '%s' "$p"
}
tool() { exec node "$MOCK_LIB/tool.mjs" "$@"; }
LAUNCHER_TAG='# hpcworker launcher for a shared copy (managed: "hpcworker install" rewrites this file)'
default_profile() { # $1 = site name: what the stand-in writes when no profile of that name is at hand
  printf '{"schema_version":1,"site":"%s","scheduler":"slurm","partition_cpu":"secp","qos_cpu":"secondary","shared_state_dir":"$HOME/.hpcworker/state","claude_config_dir":"$HOME/.claude","login_node_rules":{"max_processes":20,"poll_floor_seconds":60},"worker_defaults":{"cpus":2,"mem":"8G","hours":8,"permission_mode":"default","capacity":4}}\n' "$1" > "$PROFILE"
}
now() { date -u +%FT%TZ; }
die() { echo "hpcworker: $*" >&2; exit 1; }
state_dir() { # the profile's shared_state_dir with $HOME and $USER expanded, as the real tool's profile.py does
  local raw; raw=$(tr -d '\n' < "$PROFILE" 2>/dev/null | grep -o '"shared_state_dir": *"[^"]*"' | head -1 | cut -d'"' -f4)
  raw="${raw:-\$HOME/.hpcworker}"
  raw="${raw//\$HOME/$HOME}"; raw="${raw//\$USER/${USER:-student}}"
  map_root "$raw"
}
site() { tr -d '\n' < "$PROFILE" 2>/dev/null | grep -o '"site": *"[^"]*"' | head -1 | cut -d'"' -f4; }
# the environment id is stable per machine (Claude Code keys it to remoteControlMachineId); here per mock home
env_id() { printf '%s' "${MOCK_ENV_ID:-env_01$(printf '%s' "$HOME" | md5sum | cut -c1-24)}"; }
env_url() { printf 'https://claude.ai/code?environment=%s' "$(env_id)"; }
# Claude Code names the session itself: <node>-<word>-<word>; fixed words per worker name so tests can predict them
session_name() {
  local adj=(hazy quiet amber brisk) noun=(meadow harbor ridge lantern)
  local n; n=$(printf '%s' "$1" | cksum | cut -d' ' -f1)
  printf 'node01-%s-%s' "${adj[$((n % 4))]}" "${noun[$(((n / 4) % 4))]}"
}
registration_block() { # SESSION_NAME: exactly what claude remote-control 2.1.283 prints after the QR code
  cat <<EOT

  █▀▀▀▀▀█ ▄▀▄▀ █▀▀▀▀▀█
  █ ███ █ ▀ █▄ █ ███ █
  █ ▀▀▀ █ ▄▀▀▄ █ ▀▀▀ █
  ▀▀▀▀▀▀▀ ▀ ▀ ▀ ▀▀▀▀▀▀▀

·✔︎· Connected · phone · HEAD
    Capacity: 1/32 · New sessions will be created in the current directory
    $1
Continue coding in the Claude mobile app or $(env_url)
Or ask Claude to work in this folder from your projects on claude.ai
EOT
}
case "${1:-}" in
  connect) shift; tool connect "$@" ;;
  login-setup) shift; tool login-setup "$@" ;;
  install)
    name=""; shared=""
    while [ $# -gt 1 ]; do
      case "$2" in
        --profile) name="${3:-}"; shift 2;;
        --shared) case "${3:-}" in ""|--*) shared="${MOCK_SHARED_REAL:-}"; shift;; *) shared="$3"; shift 2;; esac;;
        *) shift;;
      esac
    done
    if [ -n "$shared" ]; then
      # the lab's shared copy: nothing is copied; the account gets a launcher, the marker and a profile.
      # The sentences, the exit code 3 for a folder this account cannot use, the launcher's tag line and
      # the replaced/<time>/ folder are framework 5's (framework/bin/hpcworker install_shared).
      dir="${shared%/}"; ddir=$(show "$dir")
      if ! { [ -d "$dir" ] && [ -r "$dir" ]; }; then echo "hpcworker: the shared copy at $ddir cannot be used from this account: this account cannot open it (it does not exist, or this account is not in the group that may read it). Nothing was changed." >&2; exit 3; fi
      if ! [ -s "$dir/VERSION" ]; then echo "hpcworker: the shared copy at $ddir cannot be used from this account: it has no readable VERSION file. Nothing was changed." >&2; exit 3; fi
      ver=$(tr -d ' \r\n' < "$dir/VERSION"); prev=$(head -1 "$HPCW_HOME/shared" 2>/dev/null)
      mkdir -p "$HPCW_HOME/log"
      # the pieces of an own copy (the launcher is not one) are moved aside whole, never deleted
      parts=""; for x in bin/hpcworker lib jobs profiles VERSION README.md; do
        [ -e "$HPCW_HOME/$x" ] || continue
        [ "$x" = bin/hpcworker ] && sed -n 2p "$HPCW_HOME/$x" | grep -qxF "$LAUNCHER_TAG" && continue
        parts="$parts $x"
      done
      aside=""
      if [ -n "$parts" ]; then
        aside="$HPCW_HOME/replaced/$(date -u +%Y%m%d-%H%M%S)"
        for x in $parts; do mkdir -p "$(dirname "$aside/$x")"; mv -f "$HPCW_HOME/$x" "$aside/$x"; done
      fi
      mkdir -p "$HPCW_HOME/bin"
      { printf '%s\n' '#!/bin/bash' "$LAUNCHER_TAG" "# This account uses the lab's shared copy of hpcworker; its profile, log and consent marker stay in this folder."
        printf 'HPCW_SHARED_ROOT=%q\n' "$dir"
        printf '[ -r "$HPCW_SHARED_ROOT/bin/hpcworker" ] || { echo "hpcworker: the shared copy at %s cannot be read from this account (ask your lab lead to give this account access to it)" >&2; exit 3; }\n' "$ddir"
        printf '%s\n' 'exec bash "$HPCW_SHARED_ROOT/bin/hpcworker" "$@"'
      } > "$HPCW_HOME/bin/hpcworker"
      chmod 755 "$HPCW_HOME/bin/hpcworker" 2>/dev/null
      printf '%s\n' "$ddir" > "$HPCW_HOME/shared"
      if [ -s "$PROFILE" ]; then echo "profile.json exists; kept (use --force to replace it with '${name:-mock}')"
      elif [ -n "$name" ] && [ -r "$dir/profiles/$name.json" ]; then cp "$dir/profiles/$name.json" "$PROFILE"; echo "profile.json written from '$name'"
      else default_profile "${name:-mock}"; echo "profile.json written from '${name:-mock}'"; fi
      if [ -n "$parts" ]; then echo "switched to the shared copy of hpcworker $ver at $ddir; your own copy was moved to $(show "$aside") (nothing deleted)"
      elif [ -z "$prev" ]; then echo "installed: this account uses the shared copy of hpcworker $ver at $ddir (nothing copied into $(show "$HPCW_HOME"))"
      else echo "hpcworker $ver: shared copy at $ddir; launcher and marker refreshed (nothing copied)"; fi
      echo "next: hpcworker diag, then hpcworker probe, then hpcworker claude login (once: sign-in and the Remote Control question in one sitting), hpcworker worker start"
      exit 0
    fi
    # the account's own copy: a shared-copy marker left from before is moved aside, so this copy is the one that runs
    if [ -e "$HPCW_HOME/shared" ]; then
      left=$(head -1 "$HPCW_HOME/shared"); aside="$HPCW_HOME/replaced/$(date -u +%Y%m%d-%H%M%S)"; mkdir -p "$aside"; mv -f "$HPCW_HOME/shared" "$aside/shared"
      echo "this account now uses its own copy; the shared copy at $left is no longer used (its marker is in $(show "$aside"))"
    fi
    mkdir -p "$HPCW_HOME"/{bin,lib/adapters,jobs,profiles,log}
    [ -s "$PROFILE" ] && echo "profile.json exists; kept (use --force to replace it with '${name:-mock}')" || {
      default_profile "${name:-mock}"
      echo "profile.json written from '${name:-mock}'"
    }
    echo "installed hpcworker 1 at $(show "$HPCW_HOME")"
    echo "next: hpcworker diag, then hpcworker probe, then hpcworker claude login (once: sign-in and the Remote Control question in one sitting), hpcworker worker start"
    ;;
  discover)
    printf '{"version":1,"when":"%s","host":"login1","user":"%s","os":"CentOS Linux 7 (Core)","glibc":"2.17","scheduler":{"family":"slurm","bins":{"sbatch":"/usr/bin/sbatch","squeue":"/usr/bin/squeue","scancel":"/usr/bin/scancel","sinfo":"/usr/bin/sinfo"}},"runtime":{"candidates":[],"modules":["apptainer/1.2.2","singularity/3.5.2"],"pyxis":false,"user_namespaces":{"max":15000}},"partitions":[{"name":"secp","timelimit":"1-00:00:00","avail":"up","default":false},{"name":"reqp","timelimit":"7-00:00:00","avail":"up","default":true}],"qos":"secondary requeue","env":{"TMPDIR":"/wsu/tmp","SLURM_TMPDIR":"","L_SCRATCH":"","https_proxy":"","no_proxy":""},"tools":{"tmux":"/usr/bin/tmux","script":"/usr/bin/script","python3":"/usr/bin/python3","curl":"/usr/bin/curl"},"home_fs":"panfs","home_dev":"panfs://home","process_count":7}\n' "$(now)" "${USER:-student}"
    ;;
  probe)
    [ -s "$PROFILE" ] || die "no profile at $(show "$PROFILE"): run 'hpcworker install --profile wayne' (or 'hpcworker install --discover')"
    sd=$(state_dir); mkdir -p "$sd/probe"
    id=$(node "$MOCK_LIB/jobs.mjs" add hpcw_probe)
    cat > "$sd/probe/probe.json" <<EOF
{"version":1,"when":"$(now)","job":"$id","hostname":"node01","os":"CentOS Linux 7 (Core)","glibc":"2.17",
 "node_tmp":{"path":"/tmp/${USER:-student}/hpcworker_$id","ok":true,"free_gb":210,"fs":"xfs","device":"/dev/sda3"},
 "tmpdir":{"value":"/wsu/tmp","fs":"ceph","device":"ceph-fuse","node_local":false},
 "dev_shm":{"size_kb":65000000,"free_kb":64000000,"writable":true},
 "user_namespaces":{"max":15000,"unshare_works":true},
 "run_user_dir":{"path":"/run/user/1000","present":false},
 "xdg_fix":{"dir":"/dev/shm/${USER:-student}/xdg","host_writable":true,"in_image":"true"},
 "tmux":{"present":true,"version":"tmux 1.8"},"script_present":true,
 "runtime":{"ok":true,"name":"apptainer","bin":"/wsu/el7/gnu7/apptainer/1.2.2/bin/apptainer","module":"apptainer/1.2.2","version":"apptainer version 1.2.2"},
 "image":{"type":"sandbox","path":"/rs/shared/claude-node22","node_version":"v22.12.0","claude_version":"2.1.283 (Claude Code)","first_exec_seconds":3,"curl_api_from_image":"404"},
 "remote_control_flags":"--name --capacity --permission-mode --continue","remote_control_help_head":"Usage: claude remote-control [options]",
 "claude_auth":{"loggedIn":${MOCK_LOGGED_IN:-true},"subscriptionType":"max","email":"student@example.edu","authMethod":"claude.ai","config_dir_present":true},
 "consent_recorded":${MOCK_CONSENT:-true},"consent_source":"$([ "${MOCK_CONSENT:-true}" = true ] && echo claude_config || echo none)","workspace_trusted":true,"sbatch_on_node":true,
 "egress":{"class":"${MOCK_EGRESS:-direct}","inherited_proxy":{"https_proxy":"","http_proxy":"","no_proxy":""},
  "with_inherited_env":{"api.anthropic.com":"404","platform.claude.com":"200","claude.ai":"403"},
  "without_proxy_vars":{"api.anthropic.com":"404","platform.claude.com":"200","claude.ai":"403"},
  "statsig.anthropic.com":"no DNS record"}}
EOF
    echo "probe job $id submitted (secp/secondary, 00:05:00). It writes $(show "$sd")/probe/probe.json; read it with: hpcworker probe --show"
    echo "(the file appears when the job has run; do not poll the scheduler: 'hpcworker probe --wait 15' checks the file once a minute)"
    ;;
  worker)
    [ -s "$PROFILE" ] || die "no profile at $(show "$PROFILE"): run 'hpcworker install --profile wayne' (or 'hpcworker install --discover')"
    sub="${2:-list}"; shift 2 2>/dev/null || shift $#
    args=("$@")
    name="worker"; pm="default"; as_json=0
    while [ $# -gt 0 ]; do case "$1" in --name) name="$2"; shift 2;; --permission-mode) pm="$2"; shift 2;; --json) as_json=1; shift;; *) shift;; esac; done
    sd=$(state_dir); rd="$sd/$name"; st=$(site); sn=$(session_name "$name"); eu=$(env_url)
    dsd=$(show "$sd"); drd=$(show "$rd") # the same two directories as the student sees them
    case "$sub" in
      start)
        # framework 10's start (the queued file; the mock portal's job simulator takes the job from there)
        if [ "${MOCK_SIM:-}" = 1 ] || [ "${MOCK_QUEUE_S:-0}" != 0 ] || [ "${MOCK_START_S:-0}" != 0 ]; then tool start "${args[@]}"; fi
        # the 10.0.0 stand-in's instant start: the job is online the moment it is submitted
        [ -e "$sd/workspaces/$name/.restricted" ] && die "refusing to start: the workspace $dsd/workspaces/$name is marked restricted (remove .restricted yourself if that no longer applies)"
        mkdir -p "$rd" "$sd/workspaces/$name"
        if [ -s "$rd/job.id" ] && node "$MOCK_LIB/jobs.mjs" list | grep -q "\"pbsid\":\"$(cat "$rd/job.id")\""; then echo "worker $name already has job $(cat "$rd/job.id") (RUNNING on node01); nothing submitted"; exit 0; fi
        id=$(node "$MOCK_LIB/jobs.mjs" add "hpcw_$name")
        echo "$id" > "$rd/job.id"; echo node01 > "$rd/node"; rm -f "$rd/stop" "$rd/stop.done"
        nid=$((id + 1)); echo "$nid $id" > "$rd/next.id"
        t=$(now); ends=$(date -u -d "+8 hours" +%FT%TZ 2>/dev/null || echo "$t")
        title=$(tr -d '\n' < "$PROFILE" 2>/dev/null | grep -o '"session_title": *"[^"]*"' | head -1 | cut -d'"' -f4); title="${title:-Grid worker}"; [ "$name" = worker ] || title="$title · $name"
        printf '{"version":10,"site":"%s","run":"%s","job":"%s","node":"node01","pid":4242,"state":"online","message":"Open in Claude: %s and find %s (or tap Code in the Claude app). Connected · phone · HEAD","needs":"nothing","hint":"Your worker is online.","submitted_at":"%s","got_computer_at":"%s","started_at":"%s","online_at":"%s","ends_at":"%s","renewal":false,"updated_at":"%s","title":"%s","session_name":"%s","requested_name":"%s-%s","session_url":"%s","environment_url":"%s","environment_id":"%s","claude_login":{"loggedIn":true,"email":"student@example.edu","subscriptionType":"max","checked_at":"%s"},"consent":true,"consent_source":"claude_config","workspace_trusted":true,"rc_alive":true,"resumed":false,"tmux":true,"restarts":0,"chain":true,"next_job":"%s","chain_note":"successor %s queued (afterany:%s)","workspace":"%s","rc_log":"%s","token_path":"%s"}\n' \
          "$st" "$name" "$id" "$eu" "$sn" "$t" "$t" "$t" "$t" "$ends" "$t" "$title" "$sn" "$st" "$id" "$eu" "$eu" "$(env_id)" "$t" "$nid" "$nid" "$id" "$dsd/workspaces/$name" "$drd/rc.log" "$drd/job.token" > "$rd/status.json"
        printf '{"session_name":"%s","requested_name":"%s-%s","session_url":"%s","environment_url":"%s","environment_id":"%s","node":"node01","job":"%s","pid":4242,"started_at":"%s","token_path":"%s","workspace":"%s","rc_log":"%s","permission_mode":"%s","capacity":"1/32","resumed":false,"next_job":"%s","title":"%s","online_at":"%s"}\n' \
          "$sn" "$st" "$id" "$eu" "$eu" "$(env_id)" "$id" "$t" "$drd/job.token" "$dsd/workspaces/$name" "$drd/rc.log" "$pm" "$nid" "$title" "$t" > "$rd/connection.json"
        { printf '\n===== %s job %s on node01: starting claude remote-control --name %s-%s --permission-mode %s =====\n' "$t" "$id" "$st" "$id" "$pm"; registration_block "$sn"; } > "$rd/rc.log"
        printf '%s Asked the grid for a computer\n%s Got a computer\n%s Connecting to Claude\n%s Online: %s\n' "$t" "$t" "$t" "$t" "$eu" >> "$rd/progress.log"
        echo "worker $name submitted as job $id (secp/secondary, 8 h). When it registers, find its session under Code in the Claude app (the name is in status.json) or open $eu"
        echo "watch it with: hpcworker worker status --name $name   (reads $drd/status.json; no scheduler polling)"
        ;;
      stop|status|restrict) tool "$sub" "${args[@]}" ;;
      list) for d in "$sd"/*/; do [ -s "$d/job.id" ] && printf '%-16s job %-10s %s\n' "$(basename "$d")" "$(cat "$d/job.id")" "online"; done ;;
      *) die "worker: start|stop|status|restrict|list";;
    esac
    ;;
  claude)
    case "${2:-}" in
      login)
        if [ "${3:-}" = "--plain" ]; then
          # plain mode: the lines the extension's login terminal reads (contract.ts LOGIN_LINES), around a
          # stand-in for Claude Code's paste-code sign-in; the typed code is read from standard input
          echo "HPCW-LOGIN 1 plain"
          echo "HPCW-LOGIN: asking the scheduler for a compute node (secp/secondary, 30 min)"
          sleep 1
          echo "HPCW-LOGIN: node01 allocated; starting Claude Code's sign-in"
          echo "Browser didn't open? Use the url below to sign in:"
          echo
          echo "AUTH-URL: https://claude.ai/oauth/authorize?code=true&client_id=mock-client&response_type=code&redirect_uri=https%3A%2F%2Fplatform.claude.com%2Foauth%2Fcode%2Fcallback&scope=user%3Ainference&state=mockstate$(date +%s)"
          echo
          printf 'Paste code here if prompted > '
          code=""; IFS= read -r code || true
          echo
          if [ "${MOCK_LOGIN_FAIL:-}" = 1 ] || [ -z "$code" ] || ! printf '%s' "$code" | grep -q -E '^[A-Za-z0-9#_-]{6,}$'; then
            echo "HPCW-LOGIN-FAILED the code was empty or not accepted (Claude Code's sign-in exited 1)"
            exit 1
          fi
          mkdir -p "$HPCW_HOME"; touch "$HPCW_HOME/consent"
          # the account is now signed in to Claude (what the framework 10 stand-in and the job simulator read)
          mkdir -p "$HOME/.mock-ood"; printf '{"loggedIn":true,"email":"student@example.edu","subscriptionType":"max","at":"%s"}\n' "$(now)" > "$HOME/.mock-ood/claude.json"
          echo "Login successful. Press Enter to continue…"
          echo "SIGNED-IN student@example.edu max (Remote Control answer on record)"
          exit 0
        fi
        echo "(mock) Sign in to Claude on the cluster, in one sitting: the real tool runs Claude Code's own 'claude auth login' inside an allocation on a compute node and never sees the credential;"
        echo "(mock) then, if Claude Code has not yet recorded your answer to \"Enable Remote Control?\" (remoteDialogSeen in its own settings file), it starts 'claude remote-control' once in your workspace so you answer y and press Ctrl-C."
        mkdir -p "$HPCW_HOME"; touch "$HPCW_HOME/consent";;
      consent)
        if [ "${3:-}" = "--record" ]; then tool consent-record "${4:-}"; fi
        echo "(mock) Nothing separate to do: 'hpcworker claude login' asks the Remote Control question in the same sitting when it has not been answered yet. This alias runs that step alone for a sign-in made earlier."; mkdir -p "$HPCW_HOME"; touch "$HPCW_HOME/consent";;
      status) echo '{"loggedIn":true,"email":"student@example.edu","subscriptionType":"max"}';;
      *) die "claude: login|consent|status";;
    esac
    ;;
  diag)
    printf '{"version":1,"host":"login1","user":"%s","nodes":[{"id":"hpcw.scripts","ok":true,"detail":"hpcworker 1 (mock)"},{"id":"hpcw.python3","ok":true,"detail":"/usr/bin/python3 (3.6)"},{"id":"hpcw.profile","ok":%s,"detail":"%s"}]}\n' "${USER:-student}" "$([ -s "$PROFILE" ] && echo true || echo false)" "$([ -s "$PROFILE" ] && echo "profile ok" || echo "no profile")"
    ;;
  version)
    # through the launcher this file runs from the shared folder: its VERSION and where it is, as framework 5 prints them
    here=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
    if [ -s "$HPCW_HOME/shared" ] && [ -s "$here/VERSION" ]; then printf '%s (shared copy at %s)\n' "$(tr -d ' \r\n' < "$here/VERSION")" "$(head -1 "$HPCW_HOME/shared")"
    elif [ -s "$HPCW_HOME/VERSION" ]; then tr -d ' \r\n' < "$HPCW_HOME/VERSION"; echo
    else echo 1; fi
    ;;
  *)
    echo "usage: hpcworker install [--profile NAME] [--shared [DIR]] | discover | probe | connect [--name N] [--profile SITE] [--consent ID] [--login auto|always|fresh|never] [--permission-mode M] [--no-chain] | worker start|stop|status|restrict|list [--name N] [--permission-mode M] [--json] | claude login [--plain]|consent [--record ID]|status | login-setup [--remove] | diag [--json] | version" >&2
    exit 2
    ;;
esac
