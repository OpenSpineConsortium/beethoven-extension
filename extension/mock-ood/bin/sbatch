#!/bin/bash
# mock sbatch: registers a job and prints its id the way the real one does; MOCK_SBATCH_FAIL=1 plays a
# refusal with the scheduler's own words
if [ "${MOCK_SBATCH_FAIL:-}" = 1 ]; then echo "sbatch: error: Batch job submission failed: Invalid qos specification" >&2; exit 1; fi
parsable=0; script=""
for a in "$@"; do
  case "$a" in
    --parsable) parsable=1 ;;
    -*) ;;
    *) script="$a" ;;
  esac
done
name="${script##*/}"; name="${name:-job}"
id=$(node "$MOCK_LIB/jobs.mjs" add "$name")
if [ "$parsable" = 1 ]; then echo "$id"; else echo "Submitted batch job $id"; fi
